# Copy to .env for local admin sign-in (npm run dev:netlify). Never commit .env.
# On Netlify, set the same names under Site configuration > Environment variables.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Any long random string; signs the 8-hour admin sessions
SESSION_SECRET=replace-with-a-long-random-string
# Bullhorn REST API credentials (server-side only; used by the Bullhorn sync function)
BULLHORN_CLIENT_ID=
BULLHORN_CLIENT_SECRET=
BULLHORN_USERNAME=
BULLHORN_PASSWORD=
